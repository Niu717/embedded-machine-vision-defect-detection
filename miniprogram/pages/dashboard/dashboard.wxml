<view class="page" wx:if="{{report}}">
  <view class="hero"><text class="hero-kicker">EMBEDDED MACHINE VISION</text><text class="hero-title">检测报告中心</text><text class="hero-subtitle">瓶盖、金属工件、PCB 检测记录</text></view>
  <view class="card latest" bindtap="openDetail"><view class="row"><text class="section-title">最新检测会话</text><text class="badge {{report.verdict === 'FAIL' ? 'badge-fail' : 'badge-ready'}}">{{report.verdict}}</text></view><text class="mode">{{report.mode}}</text><text class="muted">{{report.time}}</text><view class="metrics"><view><text>{{report.total}}</text><text>检测总数</text></view><view><text class="pass">{{report.passed}}</text><text>合格</text></view><view><text class="fail">{{report.failed}}</text><text>不合格</text></view><view><text>{{report.yieldRate}}</text><text>合格率</text></view></view><text class="result">{{report.result}}</text></view>
  <view class="card"><text class="section-title">系统状态</text><view class="status"><text>● 上位机记录模块</text><text class="online">已准备</text></view><view class="status"><text>● STM32 执行模块</text><text class="online">按电脑连接状态同步</text></view><view class="status"><text>● 小程序数据同步</text><text class="muted">当前为本地演示数据</text></view></view>
  <button class="primary" bindtap="openReports">查看全部检测报告</button>
  <button wx:if="{{cloudEnabled}}" class="primary secondary" bindtap="seedCloudReports">同步本地演示报告到云端</button>
</view>
