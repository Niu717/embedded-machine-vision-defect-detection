.hero { background: linear-gradient(135deg,#102a43,#0f766e); border-radius: 22rpx; padding: 42rpx 30rpx; color: #fff; margin-bottom: 22rpx; display:flex; flex-direction:column; }.hero-kicker { font-size: 20rpx; letter-spacing: 2rpx; opacity:.76; }.hero-title { font-size: 48rpx; font-weight:700; margin:12rpx 0; }.hero-subtitle { font-size:25rpx; opacity:.86; }.row { display:flex; align-items:center; justify-content:space-between; }.badge { padding:7rpx 15rpx; border-radius:999rpx; font-size:22rpx; font-weight:700; }.badge-fail { background:#fee2e2; color:#dc2626; }.badge-ready { background:#e0f2fe; color:#0369a1; }.latest { border-left: 8rpx solid #0f766e; }.mode { display:block; font-size:31rpx; font-weight:700; margin-bottom:6rpx; }.metrics { display:flex; justify-content:space-between; padding:24rpx 0; }.metrics view { display:flex; flex-direction:column; align-items:center; }.metrics text:first-child { font-size:32rpx; font-weight:700; }.metrics text:last-child { color:#64748b; font-size:21rpx; margin-top:8rpx; }.result { background:#f1f5f9; padding:14rpx; border-radius:10rpx; font-size:25rpx; display:block; }.status { display:flex; justify-content:space-between; padding:16rpx 0; border-bottom:1rpx solid #e2e8f0; font-size:25rpx; }.online { color:#15803d; }.primary { background:#0f766e; color:#fff; border-radius:14rpx; font-size:29rpx; margin-top:6rpx; }
