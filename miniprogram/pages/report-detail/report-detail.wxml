<view class="page" wx:if="{{report}}"><view class="card top"><text class="mode">{{report.mode}}</text><text class="muted">报告编号：{{report.id}}</text><text class="muted">检测时间：{{report.time}}</text><text class="large {{report.verdict === 'FAIL' ? 'fail' : ''}}">{{report.result}}</text></view><view class="card"><text class="section-title">统计结果</text><view class="grid"><view><text>{{report.total}}</text><text>总数</text></view><view><text class="pass">{{report.passed}}</text><text>合格</text></view><view><text class="fail">{{report.failed}}</text><text>不合格</text></view><view><text>{{report.yieldRate}}</text><text>合格率</text></view></view></view><view class="card"><text class="section-title">缺陷与建议</text><text wx:if="{{report.defects.length}}" class="defect">{{report.defects}}</text><text class="note">{{report.note}}</text></view><button class="primary" bindtap="share">生成 / 分享 PDF 报告</button></view>
