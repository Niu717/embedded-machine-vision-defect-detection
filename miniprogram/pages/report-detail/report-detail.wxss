.top { display:flex; flex-direction:column; gap:12rpx; }.mode { font-size:34rpx; font-weight:700; }.large { margin-top:18rpx; font-size:40rpx; font-weight:700; color:#0369a1; }.grid { display:grid; grid-template-columns:repeat(4,1fr); }.grid view { display:flex; flex-direction:column; align-items:center; }.grid text:first-child { font-size:33rpx; font-weight:700; }.grid text:last-child { color:#64748b; font-size:22rpx; margin-top:8rpx; }.defect { display:block; color:#dc2626; font-weight:700; margin-bottom:14rpx; }.note { display:block; line-height:1.8; color:#475569; font-size:26rpx; }.primary { background:#0f766e; color:#fff; border-radius:14rpx; font-size:29rpx; }
