<view class="page"><view class="filter"><text>全部报告</text><text>本地演示数据</text></view><view wx:for="{{reports}}" wx:key="id" class="card report" data-id="{{item.id}}" bindtap="openDetail"><view><text class="mode">{{item.mode}}</text><text class="muted">{{item.time}}</text></view><view class="right"><text class="verdict {{item.verdict === 'FAIL' ? 'fail' : ''}}">{{item.verdict}}</text><text>{{item.yieldRate}}</text></view></view></view>
